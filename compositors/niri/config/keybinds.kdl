binds {
    Mod+Shift+Left repeat=true { set-column-width "-30"; }
    Mod+Shift+Right repeat=true { set-column-width "+30"; }
    Mod+Shift+Up repeat=true { set-window-height "-30"; }
    Mod+Shift+Down repeat=true { set-window-height "+30"; }

    Mod+R { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+C { close-window; }
    Mod+Tab { toggle-overview; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }

    Mod+Q { spawn "kitty"; }
    Mod+E { spawn "kitty" "--title=Yazi" "-e" "yazi"; }
    Mod+A hotkey-overlay-title="Launcher" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleLauncher"; }

    Print { screenshot; }
    Mod+Print { screenshot-window; }
    Alt+Print { screenshot-screen; }

    Mod+O { quit; }
    Mod+L hotkey-overlay-title="Lock" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "lock"; }
    Mod+P hotkey-overlay-title="Lock" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "lock"; }

    Mod+V hotkey-overlay-title="Clipboard" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleClipboard"; }
    Mod+Shift+V { spawn "sh" "-c" "cliphist wipe && notify-send Clipboard 'All clipboard history cleared'"; }
    Mod+Shift+R { spawn "sh" "-c" "exec \"$HOME/.local/share/tanjun/compositors/niri/scripts/reload-shell.sh\""; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true repeat=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true repeat=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    XF86MonBrightnessUp allow-when-locked=true repeat=true { spawn "brightnessctl" "-e" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true repeat=true { spawn "brightnessctl" "-e" "set" "5%-"; }

    Mod+B { spawn "sh" "-c" "exec \"$HOME/.local/share/tanjun/scripts/bluetooth.sh\""; }

    Mod+Ctrl+A hotkey-overlay-title="Audio" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleAudio"; }
    Mod+Ctrl+W hotkey-overlay-title="Network" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleNetwork"; }
    Mod+Ctrl+C hotkey-overlay-title="Calendar" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleCalendar"; }
    Mod+Ctrl+B hotkey-overlay-title="Battery" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleBattery"; }
    Mod+Ctrl+N hotkey-overlay-title="Notifications" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleNotify"; }
    Mod+Ctrl+S hotkey-overlay-title="System" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleSidebar"; }
    Mod+Ctrl+comma hotkey-overlay-title="Settings" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleSettings"; }
    Mod+Ctrl+D hotkey-overlay-title="DND" { spawn "quickshell" "ipc" "--any-display" "call" "tanjun" "toggleDnd"; }
}
