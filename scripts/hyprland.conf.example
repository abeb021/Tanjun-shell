# Hyprland lua rice is in the clone. Attach it once:

#   bash scripts/setup.sh
#   Super+Shift+R

# That plants:
#   ~/.local/share/tanjun     -> this clone
#   ~/.config/quickshell      -> shell/
#   ~/.config/hypr/hyprland.lua  stub (XDG, no machine path)
# Vanilla hyprlang below is only a fallback if you do not use the lua rice.

exec-once = quickshell

bind = SUPER, A, exec, quickshell ipc call tanjun toggleLauncher
bind = SUPER, V, exec, quickshell ipc call tanjun toggleClipboard
bind = SUPER, TAB, exec, quickshell ipc call tanjun toggleOverview
bind = SUPER CTRL, A, exec, quickshell ipc call tanjun toggleAudio
bind = SUPER CTRL, W, exec, quickshell ipc call tanjun toggleNetwork
bind = SUPER CTRL, C, exec, quickshell ipc call tanjun toggleCalendar
bind = SUPER CTRL, B, exec, quickshell ipc call tanjun toggleBattery
bind = SUPER CTRL, N, exec, quickshell ipc call tanjun toggleNotify
bind = SUPER CTRL, S, exec, quickshell ipc call tanjun toggleSidebar
bind = SUPER CTRL, comma, exec, quickshell ipc call tanjun toggleSettings
bind = SUPER CTRL, D, exec, quickshell ipc call tanjun toggleDnd
bind = SUPER, L, exec, quickshell ipc call tanjun lock
bind = SUPER, P, exec, quickshell ipc call tanjun lock
bindl = , switch:on:Lid Switch, exec, quickshell ipc call tanjun lock
bind = SUPER, O, exec, quickshell ipc call tanjun logout
bind = SUPER SHIFT, S, exec, hyprshot -m region -o ~/Pictures/Screenshots
bind = , Print, exec, hyprshot -m region -o ~/Pictures/Screenshots

layerrule = noanim, tanjun-bar
layerrule = noanim, tanjun-sidebar
layerrule = noanim, tanjun-launcher
layerrule = noanim, tanjun-clipboard
layerrule = noanim, tanjun-overview
layerrule = noanim, tanjun-settings
layerrule = noanim, tanjun-osd
layerrule = noanim, tanjun-toast
